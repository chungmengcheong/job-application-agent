# Copy to .env and fill in real values for local development.
#
# Non-secret defaults (LLM model, reasoning effort, Google OAuth client ID,
# Chrome extension ID) are committed in backend/config.py and don't need to
# be set here unless you're overriding them for a different deployment.

# --- Secrets: required for live (non-demo) requests ---
LLM_API_KEY=
LANGSMITH_API_KEY=

# --- Authorized-user allowlist: set at least one of these ---
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# --- Local dev only ---
# Controls debug mode, development CORS, and visibility of the local-API
# toggle. Production deployments must set this to production.
ENVIRONMENT=development

# Lets `backend` resolve when running uvicorn/pytest from the repo root
# without an editable install. This is NOT read by application code (the
# app loads .env after Python has already started) - it must be exported
# into the shell/OS environment before the process starts, e.g. via direnv.
PYTHONPATH=${PYTHONPATH}:.
